@page "/play"
@rendermode InteractiveWebAssembly
@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using System.Numerics

@inject IJSRuntime JS

<div class="container" tabindex="0" @onkeydown="@HandleKeyDown" @onkeyup="@HandleKeyUp">
    <div class="row">
        <div class="p-2 canvas-container">

            <SKGLView OnPaintSurface="OnPaintSurface" IgnorePixelScaling="true" EnableRenderLoop="true"/>

        </div>
    </div>
</div>

@code {
    public record Ball(Vector2 Position, Vector2 Velocity, float Radius, Paddle? Hitter);

    public record Paddle(Vector2 Position, float Width, float Height, MovementState Movement);

    private Paddle _playerOne = new Paddle(new Vector2(-450, 0), 10f, 60f, MovementState.Idle);

    private Paddle _playerTwo = new Paddle(new Vector2(450, 0), 10f, 60f, MovementState.Idle);

    private float _paddleSpeed = 10f;

    private Ball _ball = new Ball(Vector2.Zero, new Vector2(10f, 0f), 5f, null);

    private SKPaint _ballPaint = new SKPaint
        {
            IsAntialias = true,
            Color = SKColors.CornflowerBlue,
        };

    private SKPaint _borderPaint = new SKPaint
        {
            Color = SKColors.LightGray,
            StrokeWidth = 5f,
            Style = SKPaintStyle.Stroke
        };

    private SKPaint _centerLinePaint = new SKPaint
        {
            Color = SKColors.LightGray,
            StrokeWidth = 2f,
            Style = SKPaintStyle.Stroke,
            PathEffect = SKPathEffect.CreateDash(new float[] { 15, 15 }, 0)
        };

    void OnPaintSurface(SKPaintGLSurfaceEventArgs e)
    {
        var canvas = e.Surface.Canvas;
        var surfaceSize = e.Info.Size;

        canvas.Clear(SKColors.Black);

        var borderRect = new SKRect(0, 0, surfaceSize.Width, surfaceSize.Height);
        canvas.DrawRect(borderRect, _borderPaint);


        var centerLine = new SKPath();
        centerLine.MoveTo(surfaceSize.Width / 2f, 0);
        centerLine.LineTo(surfaceSize.Width / 2f, surfaceSize.Height);
        canvas.DrawPath(centerLine, _centerLinePaint);

        // Ball position logic, update based on velocity
        _ball = _ball with { Position = _ball.Position + _ball.Velocity };

        // Check for collision with the edges (left or right)
        if (IsBallCollidingWithLeft(_ball, surfaceSize) ||
            IsBallCollidingWithRigth(_ball, surfaceSize))
        {
            _ball = _ball with { Velocity = new Vector2(-_ball.Velocity.X, _ball.Velocity.Y) };
        }

        // Check for top/bottom boundary collision
        if (IsBallCollidingWithTop(_ball, surfaceSize) ||
            IsBallCollidingWithBottom(_ball, surfaceSize))
        {
            _ball = _ball with { Velocity = new Vector2(_ball.Velocity.X, -_ball.Velocity.Y) };
        }

        if (IsBallCollidingWithPaddle(_ball, _playerOne))
        {
            var newVelocity = CalculatePaddleInpact(_ball, _playerOne);
            _ball = _ball with { Velocity = newVelocity, Hitter = _playerOne };
        }
        else if (IsBallCollidingWithPaddle(_ball, _playerTwo))
        {
            var newVelocity = CalculatePaddleInpact(_ball, _playerTwo);
            _ball = _ball with { Velocity = newVelocity, Hitter = _playerTwo };
        }

        // Convert to canvas coordinates (since center is at 0,0, need to adjust for the origin)
        var ballPos = new SKPoint(_ball.Position.X + surfaceSize.Width / 2f, _ball.Position.Y + surfaceSize.Height / 2f);

        // Draw the ball
        canvas.DrawCircle(ballPos, _ball.Radius, _ballPaint);

        // Player 1
        if (_playerOne.Movement is MovementState.MovingUp)
        {
            _playerOne = _playerOne with
            {
                Position = new Vector2(
                    _playerOne.Position.X,
                    Math.Max(_playerOne.Position.Y - _paddleSpeed, -surfaceSize.Height / 2f + _playerOne.Height / 2f)
                )
            };
        }
        else if (_playerOne.Movement is MovementState.MovingDown)
        {
            _playerOne = _playerOne with
            {
                Position = new Vector2(
                    _playerOne.Position.X,
                    Math.Min(_playerOne.Position.Y + _paddleSpeed, surfaceSize.Height / 2f - _playerOne.Height / 2f)
                )
            };
        }

        var paddleOneRect = new SKRect(
            _playerOne.Position.X + surfaceSize.Width / 2f - _playerOne.Width / 2f,
            _playerOne.Position.Y + surfaceSize.Height / 2f - _playerOne.Height / 2f,
            _playerOne.Position.X + surfaceSize.Width / 2f + _playerOne.Width / 2f,
            _playerOne.Position.Y + surfaceSize.Height / 2f + _playerOne.Height / 2f
            );

        canvas.DrawRect(paddleOneRect, _ballPaint);

        // Player 2
        if (_playerTwo.Movement is MovementState.MovingUp)
        {
            _playerTwo = _playerTwo with
                {
                    Position = new Vector2(
                        _playerTwo.Position.X,
                        Math.Max(_playerTwo.Position.Y - _paddleSpeed, -surfaceSize.Height / 2f + _playerTwo.Height / 2f)
                    )
                };
        }
        else if (_playerTwo.Movement is MovementState.MovingDown)
        {
            _playerTwo = _playerTwo with
                {
                    Position = new Vector2(
                            _playerTwo.Position.X,
                                Math.Min(_playerTwo.Position.Y + _paddleSpeed, surfaceSize.Height / 2f - _playerTwo.Height / 2f)
                    )
                };
        }

        var paddleTwoRect = new SKRect(
            _playerTwo.Position.X + surfaceSize.Width / 2f - _playerTwo.Width / 2f,
            _playerTwo.Position.Y + surfaceSize.Height / 2f - _playerTwo.Height / 2f,
            _playerTwo.Position.X + surfaceSize.Width / 2f + _playerTwo.Width / 2f,
            _playerTwo.Position.Y + surfaceSize.Height / 2f + _playerTwo.Height / 2f
            );

        canvas.DrawRect(paddleTwoRect, _ballPaint);
    }

    private static Vector2 CalculatePaddleInpact(Ball ball, Paddle paddle)
    {
        // Calculate hit position relative to the paddle center (-1 to 1)
        float relativeHitPosition = (ball.Position.Y - paddle.Position.Y) / (paddle.Height / 2f);

        // Adjust ball's velocity based on hit position
        return new Vector2(-ball.Velocity.X, ball.Velocity.Y + relativeHitPosition * 2f);
    }

    private bool IsBallCollidingWithPaddle(Ball ball, Paddle paddle)
    {
        var ballLeft = ball.Position.X - ball.Radius;
        var ballRight = ball.Position.X + ball.Radius;
        var ballTop = ball.Position.Y - ball.Radius;
        var ballBottom = ball.Position.Y + ball.Radius;

        var paddleLeft = paddle.Position.X - paddle.Width / 2f;
        var paddleRight = paddle.Position.X + paddle.Width / 2f;
        var paddleTop = paddle.Position.Y - paddle.Height / 2f;
        var paddleBottom = paddle.Position.Y + paddle.Height / 2f;

        return ballRight >= paddleLeft &&
               ballLeft <= paddleRight &&
               ballBottom >= paddleTop &&
               ballTop <= paddleBottom;
    }

    private bool IsBallCollidingWithTop(Ball ball, SKSize surfaceSize)
    {
        return ball.Position.Y - ball.Radius <= -surfaceSize.Height / 2f;
    }

    private bool IsBallCollidingWithBottom(Ball ball, SKSize surfaceSize)
    {
        return ball.Position.Y + ball.Radius >= surfaceSize.Height / 2f;
    }

    private bool IsBallCollidingWithLeft(Ball ball, SKSize surfaceSize)
    {
        return ball.Position.X - ball.Radius <= -surfaceSize.Width / 2f;
    }

    private bool IsBallCollidingWithRigth(Ball ball, SKSize surfaceSize)
    {
        return ball.Position.X + ball.Radius >= surfaceSize.Width / 2f;
    }

    public void HandleKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "ArrowUp")
            _playerOne = _playerOne with { Movement = MovementState.MovingUp };
        else if (eventArgs.Key == "ArrowDown")
            _playerOne = _playerOne with { Movement = MovementState.MovingDown };
    }

    public void HandleKeyUp(KeyboardEventArgs eventArgs)
    {
        if ((eventArgs.Key == "ArrowUp" && _playerOne.Movement == MovementState.MovingUp) ||
            (eventArgs.Key == "ArrowDown" && _playerOne.Movement == MovementState.MovingDown))
        {
            _playerOne = _playerOne with { Movement = MovementState.Idle };
        }
    }

    public enum MovementState
    {
        Idle,
        MovingUp,
        MovingDown
    }

}

