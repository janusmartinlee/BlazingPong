@page "/pong"
@rendermode InteractiveWebAssembly
@using PongEngine
@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using System.Numerics
@inject GameService GameService

<div class="p-5 container canvas-container" tabindex="0" @onkeydown="@HandleKeyDown" @onkeyup="@HandleKeyUp">
    @if (_gameState == null)
    {
        <div class ="game-overlay">
            <button @onclick="() => GameService.StartGame()">Play</button>
        </div>
    }
    else
    {
        @* <div class="p-5"> *@
                <SKGLView OnPaintSurface="OnPaintSurface" IgnorePixelScaling="true" EnableRenderLoop="true"/>

                @if (_gameState.IsGameOver)
                {
                    <div class="game-overlay">
                        <h2>Game Over</h2>
                        <p>@($"{_gameState.Ball.Hitter?.Name} wins")</p>
                        <button @onclick="() => GameService.RestartGame()">Play Again</button>
                    </div>
                }

            @* </div> *@
    }
</div>

@code {
    private InputState inputState = new();

    private GameState? _gameState;

    private SKPaint _ballPaint = new SKPaint
        {
            IsAntialias = true,
            Color = SKColors.CornflowerBlue,
        };

    private SKPaint _paddlePaint = new SKPaint
        {
            IsAntialias = true,
            Color = SKColors.CornflowerBlue,
        };

    private SKPaint _borderPaint = new SKPaint
        {
            Color = SKColors.LightGray,
            StrokeWidth = 5f,
            Style = SKPaintStyle.Stroke
        };

    private SKPaint _centerLinePaint = new SKPaint
        {
            Color = SKColors.LightGray,
            StrokeWidth = 2f,
            Style = SKPaintStyle.Stroke,
            PathEffect = SKPathEffect.CreateDash(new float[] { 15, 15 }, 0)
        };

    private SKPaint _scorePaint = new SKPaint
        {
            Color = SKColors.LightGray,
        };

    private SKFont _font = new SKFont(SKTypeface.FromFamilyName("Arial") , 50f);

    private void HandleGameStateChanged()
    {
        _gameState = GameService.GetState();
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            GameService.OnStateChanged += HandleGameStateChanged;
            GameService.InitializeGame(GameMode.PlayerVsBot);
        }
    }

    void OnPaintSurface(SKPaintGLSurfaceEventArgs e)
    {
        if (_gameState == null) return;

        var canvas = e.Surface.Canvas;
        var surfaceSize = e.Info.Size;
        canvas.Clear(SKColors.Black);

        // Scaling factors
        float scaleX = surfaceSize.Width / _gameState.Arena.Width;
        float scaleY = surfaceSize.Height / _gameState.Arena.Height;

        // Translate game coordinates to canvas center
        float centerX = surfaceSize.Width / 2f;
        float centerY = surfaceSize.Height / 2f;

        // Draw arena border
        var borderRect = new SKRect(0, 0, surfaceSize.Width, surfaceSize.Height);
        canvas.DrawRect(borderRect, _borderPaint);

        // Draw center line
        var centerLine = new SKPath();
        centerLine.MoveTo(centerX, 0);
        centerLine.LineTo(centerX, surfaceSize.Height);
        canvas.DrawPath(centerLine, _centerLinePaint);

        // Draw the ball (scaled & centered)
        var ballPos = new SKPoint(
            centerX + _gameState.Ball.Position.X * scaleX,
            centerY + _gameState.Ball.Position.Y * scaleY
        );
        float ballRadius = _gameState.Ball.Radius * scaleX; // Assuming uniform scaling
        canvas.DrawCircle(ballPos, ballRadius, _ballPaint);

        // Player 1 paddle (scaled & centered)
        var paddleOneRect = new SKRect(
            centerX + (_gameState.PlayerOne.Position.X - _gameState.PlayerOne.Width / 2f) * scaleX,
            centerY + (_gameState.PlayerOne.Position.Y - _gameState.PlayerOne.Height / 2f) * scaleY,
            centerX + (_gameState.PlayerOne.Position.X + _gameState.PlayerOne.Width / 2f) * scaleX,
            centerY + (_gameState.PlayerOne.Position.Y + _gameState.PlayerOne.Height / 2f) * scaleY
        );
        canvas.DrawRect(paddleOneRect, _paddlePaint);

        // Player 2 paddle (scaled & centered)
        var paddleTwoRect = new SKRect(
            centerX + (_gameState.PlayerTwo.Position.X - _gameState.PlayerTwo.Width / 2f) * scaleX,
            centerY + (_gameState.PlayerTwo.Position.Y - _gameState.PlayerTwo.Height / 2f) * scaleY,
            centerX + (_gameState.PlayerTwo.Position.X + _gameState.PlayerTwo.Width / 2f) * scaleX,
            centerY + (_gameState.PlayerTwo.Position.Y + _gameState.PlayerTwo.Height / 2f) * scaleY
        );
        canvas.DrawRect(paddleTwoRect, _paddlePaint);

        // Draw scores
        canvas.DrawText(_gameState.PlayerOne.Score.ToString(), centerX - 50, 75, SKTextAlign.Center, _font, _scorePaint);
        canvas.DrawText(_gameState.PlayerTwo.Score.ToString(), centerX + 50, 75, SKTextAlign.Center, _font, _scorePaint);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        //TODO: change to use movement enum, there should not be any values here
        if (e.Key == "ArrowUp")
            inputState.PlayerTwoMovementState = MovementState.MovingUp;
        if (e.Key == "ArrowDown")
            inputState.PlayerTwoMovementState = MovementState.MovingDown;
        if (e.Key == "w")
            inputState.PlayerOneMovementState = MovementState.MovingUp;
        if (e.Key == "s")
            inputState.PlayerOneMovementState = MovementState.MovingDown;

    GameService.UpdateInput(inputState);
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp" || e.Key == "ArrowDown")
            inputState.PlayerTwoMovementState = MovementState.Idle;
        if (e.Key == "w" || e.Key == "s")
            inputState.PlayerOneMovementState = MovementState.Idle;

        GameService.UpdateInput(inputState);
    }

    public void Dispose()
    {
        GameService.OnStateChanged -= StateHasChanged;
    }
}
